# Minimal local static-preview configuration. Copy to repository-root .env.local.
# Use a clean shell: inherited environment variables take precedence over this file.
# This is not the complete production environment contract.
PAC_DATA_ENV=local
# Local HTTP preview only; do not use this header mode on a public host.
PAC_OFFLINE_BUILD=1
PAC_STORE=memory
PAC_CONTENT_SOURCE=static
PAC_STAFF_SCOPE=dsd
PAC_PUBLIC_ORIGIN=http://127.0.0.1:8915
PAC_CLONE_AGENTS=off
PAC_CLONE_DAILY_REVIEW=off
PAC_GENERATIVE_PILOT=off
PAC_RESEARCH_ENABLED=off

# Production values must be provisioned in the new host's secret manager.
# Keep these commented for local static verification; no real secrets belong here.
# PAC_PUBLIC_ORIGIN=https://YOUR_NEW_HOST
# PAC_DATA_ENV=production
# PAC_STORE=postgres
# PAC_RUNTIME_DATABASE_URL=YOUR_RESTRICTED_RUNTIME_CONNECTION
# PAC_RUNTIME_DATABASE_SSL=require
# PAC_OWNER_DATABASE_URL=YOUR_SEPARATE_OWNER_CONNECTION
# PAC_CONTRIBUTOR_DATABASE_URL=YOUR_SEPARATE_CONTRIBUTOR_CONNECTION
# PAC_PROGRAM_AUTH_DATABASE_URL=YOUR_SEPARATE_AUTH_BROKER_CONNECTION
# PAC_OWNER_KEY=YOUR_NEW_STRONG_SECRET
# PAC_RATE_LIMIT_SECRET=YOUR_NEW_STRONG_SECRET
# CRON_SECRET=YOUR_NEW_STRONG_SECRET
# OPENAI_API_KEY=YOUR_NEW_PROVIDER_KEY
# TYPESAFE_API_KEY=YOUR_NEW_PROVIDER_KEY
# OPENROUTER_API_KEY=YOUR_NEW_PROVIDER_KEY
# PERPLEXITY_API_KEY=YOUR_NEW_PROVIDER_KEY

# Read config/environment-contract.json for all settings and activation conditions.
# Retain the startup gate and adapt it deliberately before enabling clone agents
# on a new service or domain. Do not enable scheduled work for a local preview.
