# Environment setting names only. Values are deliberately blank.
# See config/environment-contract.json for allowed values and conditions.
# For the isolated local preview use handoff/.env.example instead.
# Never commit real credentials; configure deployment secrets on the target host.

# owner page-text or media editing is enabled; separate pac_owner_writer database role, never the general runtime credential
PAC_OWNER_DATABASE_URL=

# owner workspace is enabled outside local development
PAC_OWNER_KEY=
PAC_LEADERS_KEY=

# every preview and production deployment
PAC_RATE_LIMIT_SECRET=

# always; defaults are environment-specific
PAC_STORE=

# optional; blank keeps owner-deletable ASK records without automatic expiry; positive days apply to new records
PAC_ASK_RECORD_RETENTION_DAYS=

# every Vercel preview and production deployment
PAC_DATA_ENV=

# migrations, imports, or runtime-role provisioning run
PAC_DATABASE_URL=

# database transport requires an explicit SSL mode
PAC_DATABASE_SSL=

# PAC_STORE=postgres or PAC_CONTENT_SOURCE=postgres
PAC_RUNTIME_DATABASE_URL=

# runtime database transport requires an explicit SSL mode
PAC_RUNTIME_DATABASE_SSL=

# an import actor must be attributed explicitly
PAC_IMPORT_ACTOR=

# Optional setting.
PAC_IMPORT_BATCH_SIZE=

# Optional setting.
PAC_IMPORT_BATCH_BYTES=

# Optional setting.
PAC_CONTENT_SOURCE=

# explicitly enabling persistent editing over the reviewed static resource collection; requires the restricted database connection and an exact reviewed resource seed
PAC_STATIC_RESOURCE_EDITING=

# the reviewed resource seed script requires yes to acknowledge that its target is the separate One DSD database; this setting does not itself isolate data
PAC_DEDICATED_DSD_DATABASE=

# selected editable surfaces use PostgreSQL while other reviewed surfaces remain static; full PostgreSQL source mode applies to all surfaces
PAC_DATABASE_EDITABLE_SURFACES=

# Optional setting.
PAC_STAFF_SCOPE=

# private source-object loading is explicitly run
PAC_SUPABASE_URL=

# Optional setting.
PAC_SUPABASE_BUCKET=

# private source-object loading is explicitly run
PAC_SUPABASE_SECRET_KEY=

# Optional setting.
PAC_CONSULTATION_INTAKE_ENABLED=

# consultation intake is activated, PAC_CONSULTATION_ACTIVATION_EVIDENCE_ID is selected for existing-request tracking, or this secret is configured in production; must pass the production non-placeholder and variation checks even when new intake is off
PAC_CONSULTATION_TRACKING_SECRET=

# consultation intake is activated
PAC_CONSULTATION_POLICY_VERSION=

# consultation intake or tracking is activated; must match an approved committed evidence bundle
PAC_CONSULTATION_ACTIVATION_EVIDENCE_ID=

# consultation intake is activated
PAC_CONSULTATION_RETENTION_DAYS=

# Optional setting.
PAC_CONSULTATION_CORRECTION_READY=

# Optional setting.
PAC_CONSULTATION_DELETION_READY=

# Optional setting.
PAC_CONSULTATION_BACKUP_READY=

# Optional setting.
PAC_CONSULTATION_RESTORE_READY=

# Optional setting.
PAC_CONSULTATION_RECOVERY_READY=

# Optional setting.
PAC_CONSULTATION_INCIDENT_READY=

# Optional setting.
PAC_CONSULTATION_DELIVERY_READY=

# Optional setting.
PAC_GENERATIVE_PILOT=

# the approved Anthropic adapter is activated
ANTHROPIC_API_KEY=

# the approved OpenAI adapter is activated
OPENAI_API_KEY=

# Optional setting.
PAC_AUTONOMY_MAX=

# Optional setting.
PAC_KILL_SWITCH=

# a Vercel cron schedule is activated
CRON_SECRET=

# Optional setting.
PAC_RESEARCH_ENABLED=

# Optional setting.
PAC_RESEARCH_KILL_SWITCH=

# Optional setting.
PAC_RESEARCH_MONTHLY_USD_CAP=

# approved live Perplexity research is activated
PERPLEXITY_API_KEY=

# Optional setting.
PAC_PERPLEXITY_CURRENT_PRESET=

# Optional setting.
PAC_PERPLEXITY_DEEP_PRESET=

# Optional setting.
PAC_MICROSOFT_ADAPTER=

# Optional setting.
PAC_MICROSOFT_KILL_SWITCH=

# the ignored resolver does not provide the 578-record catalog
PAC_CATALOG_PATH=

# the optional local import benchmark is run
PAC_IMPORT_BENCHMARK_DATABASE_URL=

# Optional setting.
PAC_RESEARCH_FIXTURE=

# Optional setting.
PAC_REQUIRE_LOCAL_CORPUS=

# optional legacy team-key sign-in only; direct owner access does not require it
PAC_TEAM_KEY=

# Calendar-year consultation retention is selected; exclusive with retention days.
PAC_CONSULTATION_RETENTION_CALENDAR_YEARS=

# Railway canonical HTTPS application origin.
PAC_PUBLIC_ORIGIN=

# Railway trusted proxy is explicitly selected.
PAC_TRUSTED_PROXY=

# Only local authorized encrypted recovery drills; 32-byte base64 key, never client, never required in the web deployment.
PAC_RECOVERY_BACKUP_KEY=

